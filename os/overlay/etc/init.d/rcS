#!/bin/sh
# MyNook's start-up, run once by init before the reader.
#
# Storage, by the Nook's partition numbers (mmcblk0 is the internal
# memory):
#
#   p5  /system          CyanogenMod's system, read-only: adb's shell
#                        (/system/bin/sh) lives there
#   p6  /data            CyanogenMod's data partition; MyNook keeps
#                        its own files in /data/mynook (saved places,
#                        settings, the dictionary, the log)
#   p8  /storage/sdcard1 the books (the MyNOOKcolor drive), at the
#                        same path CyanogenMod uses, so saved places
#                        work under both
#
# Never touched: p1 (boot) and p2 (/rom: the Nook's serial number and
# factory settings) are read only by the bootloader.

# Stay awake until the reader decides to sleep (reader/platform_fb.c).
echo mynook > /sys/power/wake_lock

# The clock: the hardware clock keeps UTC, as Android left it.
hwclock -s -u

mkdir -p /system /data /storage/sdcard1
mount -t ext4 -o noatime /dev/mmcblk0p6 /data
mkdir -p /data/mynook
# MyNook's folder: others may reach a file whose name they know (the
# logs), but not list, delete or replace anything; the saved state,
# with the passcode, is root's alone.
chmod 0711 /data/mynook
chmod 0600 /data/mynook/state /data/mynook/state.tmp 2>/dev/null

# From here on, everything this script says goes in a log that
# CyanogenMod can read over adb if MyNook misbehaves, and the kernel's
# own log is saved now and again 30 seconds in (touch, USB, sleep).
exec >> /data/mynook/boot.log 2>&1
echo "--- $(date) ---"
set -x
dmesg > /data/mynook/dmesg.boot
(sleep 30; dmesg > /data/mynook/dmesg.30s) &

mount -t ext4 -o ro /dev/mmcblk0p5 /system
mount -t vfat -o noatime,utf8,shortname=mixed /dev/mmcblk0p8 \
	/storage/sdcard1

# USB, set up the way CyanogenMod's init.encore.usb.rc does it: a
# drive with nothing in it, until the reader shares the books. adb
# only if Settings, Device, USB debugging is on (mynook-adb): with
# "adb" among the functions this kernel keeps the whole connection
# off until adbd is running, and adb while locked would get around
# the passcode.
USB=/sys/class/android_usb/android0
serial=$(sed -n 's/.*androidboot.serialno=\([^ ]*\).*/\1/p' \
	/proc/cmdline)
echo 0 > $USB/enable
echo 2080 > $USB/idVendor
echo 0002 > $USB/idProduct
echo MyNook > $USB/iManufacturer
echo "Nook Color" > $USB/iProduct
echo "$serial" > $USB/iSerial
echo NookColor > $USB/f_mass_storage/inquiry_string
echo mass_storage > $USB/functions
echo 1 > $USB/enable
if grep -q "$(printf '^#adb\t1$')" /data/mynook/state 2>/dev/null; then
	mynook-adb on
fi
